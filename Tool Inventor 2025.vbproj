<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Đổi TargetFramework sang net8.0-windows -->
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <StartupObject>ToolInventor2025.</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <PublishUrl>http://localhost/InventorAddIn/</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    
    <!-- Kích hoạt Windows Forms cho .NET 8 -->
    <UseWindowsForms>true</UseWindowsForms>
    
    <RootNamespace>ToolInventor2025</RootNamespace>
    <AssemblyName>ToolInventor2025</AssemblyName>
    <AssemblyTitle>Tool_Inventor_2025</AssemblyTitle>
    <Description>Tool_Inventor_2025</Description>
    <Company>Autodesk, Inc.</Company>
    <Product>Autodesk Inventor</Product>
    <Copyright>Copyright %3f2012 Autodesk, Inc.</Copyright>
    <AssemblyVersion>1.0.%2a</AssemblyVersion>
    
    <ImportedNamespaces>Autodesk.iLogic.Interfaces=False,Autodesk.iLogic.Runtime=False,Autodesk.iLogic.Runtime.InventorEntities=False,form=False,Inventor=False,stdole=False,System.Text=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,Tool Inventor 2025=True</ImportedNamespaces>
    
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>C:\ProgramData\Autodesk\Inventor 2025\Addins</OutputPath>
    <DocumentationFile>.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
    <RegisterForComInterop>false</RegisterForComInterop>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
